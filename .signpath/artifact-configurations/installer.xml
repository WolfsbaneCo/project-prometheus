<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "installer": the installer (the GitHub artifact
     "unsigned-installer", a zip holding ProjectPrometheus-Setup-<version>.exe). Paste into the
     SignPath project with the slug installer. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="ProjectPrometheus-Setup-*.exe">
      <authenticode-sign/>
    </pe-file>
  </zip-file>
</artifact-configuration>
